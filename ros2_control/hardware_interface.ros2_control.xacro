<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org.wiki/xacro">

    <xacro:include filename='$(find quaro_hardware_interface)/ros2_control/lx224hv_interface.ros2_control.xacro'/>

    <xacro:macro name="quaro_ros2_control">
        <ros2_control name="quaro_legs_hardware_interface" type="system" rw_rate="50">
            <hardware>
                <plugin>quaro_hardware_interface/QuaroSystem</plugin>
            </hardware>

            <xacro:lx224hv_servo_interface name="hip_0"/>
            <xacro:lx224hv_servo_interface name="knee_0"/>
            <xacro:lx224hv_servo_interface name="ankle_0"/>

            <xacro:lx224hv_servo_interface name="hip_1"/>
            <xacro:lx224hv_servo_interface name="knee_1"/>
            <xacro:lx224hv_servo_interface name="ankle_1"/>

            <xacro:lx224hv_servo_interface name="hip_2"/>
            <xacro:lx224hv_servo_interface name="knee_2"/>
            <xacro:lx224hv_servo_interface name="ankle_2"/>

            <xacro:lx224hv_servo_interface name="hip_3"/>
            <xacro:lx224hv_servo_interface name="knee_3"/>
            <xacro:lx224hv_servo_interface name="ankle_3"/>

            <sensor name="imu">
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>

                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
            </sensor>

            <sensor name="battery">
                <state_interface name="battery_voltage"/>
            </sensor>
        </ros2_control>
    </xacro:macro>
</robot>