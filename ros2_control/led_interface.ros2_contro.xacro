<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org.wiki/xacro">
    <xacro:macro name="quaro_led" params="name">
        <gpio name="${name}">
            <command_interface name="red" data_type="uint8_t">
                <param name="min">0</param>
                <param name="max">255</param>
            </command_interface>
        </gpio>
    </xacro:macro>
</robot>