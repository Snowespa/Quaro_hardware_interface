<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org.wiki/xacro">
    <xacro:macro name="quaro_buzzer" param="name">
        <gpio name="${name}">
            <command_interface name="on_time" data_type="float">
                <param name="min">0.0</param>
            </command_interface>

            <command_interface name="off_time" data_type="float">
                <param name="min">0.0</param>
            </command_interface>

            <command_interface name="frequency" data_type="float">
                <param name="min">0.0</param>
            </command_interface>

            <command_interface name="repeat" data_type="float">
                <param name="min">0.0</param>
            </command_interface>
        </gpio>
    </xacro:name>
</robot>